-- ===========================================================================
--  VFXEdu CorridorKey 2.0 - Native Fusion Fuse Node
--  Zero-Popup Native Node for DaVinci Resolve Fusion Page
-- ===========================================================================

FuRegisterClass("CorridorKeyer", CT_Tool, {
    REGS_Name = "CorridorKeyer",
    REGS_Category = "Keyer||VFXEdu",
    REGS_OpIconString = "CK",
    REGS_OpDescription = "VFXEdu CorridorKey 2.0 AI Video Keyer",
    REGS_Company = "VFXEdu",
    REG_NoMotionBlurCtrls = true,
    REG_NoBlendCtrls = true,
    REG_OpNoMask = true,
    REG_Version = 100,
})

function Create()
    -- Inputs (Flow Graph)
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    InHint = self:AddInput("FrameHint", "FrameHint", {
        LINKID_DataType = "Image",
        LINK_Main = 2,
    })

    -- Output (Flow Graph)
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Inspector Controls
    self:BeginControlNest("CorridorKeyer 2.0 Parameters", "CKParams", true, {})

    InHeader = self:AddInput("VFXEdu CorridorKey 2.0 AI Keyer", "HeaderLbl", {
        LINKID_DataType = "Text",
        INPID_InputControl = "LabelControl",
        INP_External = false,
        INP_Passive = true,
    })

    InDespill = self:AddInput("Despill Strength", "DespillStrength", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.5,
        INP_MinAllowed = 0.0,
        INP_MaxAllowed = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
    })

    InFormat = self:AddInput("Output Format", "OutputFormat", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Apple ProRes 4444 (RGBA Cutout)" },
        { CCS_AddString = "OpenEXR Sequence (16-bit Half)" },
        { CCS_AddString = "H.264 Video (Alpha + Clean FG)" },
    })

    InLowVRAM = self:AddInput("Force Low VRAM Mode", "ForceLowVRAM", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Default = 0.0,
        INP_Integer = true,
    })

    InStatus = self:AddInput("Status: Ready to Render", "StatusLbl", {
        LINKID_DataType = "Text",
        INPID_InputControl = "LabelControl",
        INP_External = false,
        INP_Passive = true,
    })

    InRender = self:AddInput("⚡ Run CorridorKey AI", "RenderButton", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ButtonControl",
        INP_Integer = true,
        INP_Default = 0,
        INP_DoNotifyChanged = true,
        INP_External = false,
    })

    InOpenFolder = self:AddInput("📂 Open Render Folder", "OpenFolderButton", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ButtonControl",
        INP_Integer = true,
        INP_Default = 0,
        INP_DoNotifyChanged = true,
        INP_External = false,
    })

    self:EndControlNest()
end

function NotifyChanged(inp, param, time)
    if param and param.Value == 1 then
        if inp == InRender then
            local node_name = self.Name
            local despill = InDespill:GetValue(self.Comp.CurrentTime).Value
            local fmt = InFormat:GetValue(self.Comp.CurrentTime).Value
            local low_vram = InLowVRAM:GetValue(self.Comp.CurrentTime).Value

            -- Resolve root directory
            local root = [[__CORRIDORKEY_ROOT__]]
            local test_f = io.open(root .. "/resolve/fusion/corridorkey_fusion.py", "r")
            if test_f then
                test_f:close()
            else
                local candidates = {
                    os.getenv("CORRIDORKEY_ROOT") or "",
                    [[K:/Pateron/CorridorKeyer2.0_Portable]],
                    [[K:/________________VFXEdu_Script/CorridorKeyer2.0]],
                    [[C:/CorridorKey2.0]],
                }
                for _, c in ipairs(candidates) do
                    if c and c ~= "" then
                        local f = io.open(c .. "/resolve/fusion/corridorkey_fusion.py", "r")
                        if f then
                            f:close()
                            root = c
                            break
                        end
                    end
                end
            end

            local script_path = root .. "/resolve/fusion/corridorkey_fusion.py"

            -- Try python_embed first, then venv, then system python
            local py_exe = nil
            local py_candidates = {
                root .. "/python_embed/python.exe",
                root .. "/venv/Scripts/python.exe",
            }
            for _, py in ipairs(py_candidates) do
                local f_py = io.open(py, "r")
                if f_py then
                    f_py:close()
                    py_exe = py
                    break
                end
            end
            if not py_exe then
                py_exe = "python"
            end

            local cmd = string.format('start /b "" "%s" "%s" --node "%s" --despill %.2f --fmt %d --low-vram %d',
                py_exe, script_path, node_name, despill, fmt, low_vram)
            os.execute(cmd)

        elseif inp == InOpenFolder then
            local out_dir = [[C:/CorridorKey_Renders]]
            local f = io.open(out_dir, "r")
            if not f then
                out_dir = [[K:/CorridorKey_Renders]]
            else
                f:close()
            end
            os.execute(string.format('start "" "%s"', out_dir))
        end
    end
end

function Process(req)
    local img = InImage:GetValue(req)
    if not img then
        return
    end

    -- Pass-through video stream to Output
    OutImage:Set(req, img)
end
